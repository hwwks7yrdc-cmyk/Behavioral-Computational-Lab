import random

from otree.api import *

doc = """
[[ spec.title ]]: [[ n ]]-person public goods game ([[ spec.matching ]] matching, MPCR [[ spec.mpcr ]][% if spec.punishment.enabled %], peer punishment[% endif %][% if spec.threshold.enabled %], threshold [[ spec.threshold.amount ]][% endif %]).
"""


class C(BaseConstants):
    NAME_IN_URL = '[[ spec.name ]]'
    PLAYERS_PER_GROUP = [[ n ]]
    NUM_ROUNDS = [[ spec.num_rounds ]]
    ENDOWMENT = [[ e ]]
    MPCR = [[ spec.mpcr ]]
    MULTIPLIER = [[ spec.multiplier ]]
    MATCHING = '[[ spec.matching ]]'
    SHOW_HISTORY = [[ spec.show_history ]]
    TIMEOUT_SECONDS = [[ spec.decision_timeout_seconds ]]

    PUNISHMENT = [[ spec.punishment.enabled ]]
    PUNISH_MAX = [[ spec.punishment.max_points ]]
    PUNISH_COST = [[ spec.punishment.cost_per_point ]]
    PUNISH_IMPACT = [[ spec.punishment.impact_per_point ]]
    FLOOR_AT_ZERO = [[ spec.punishment.floor_at_zero ]]

    THRESHOLD = [[ spec.threshold.enabled ]]
    THRESHOLD_AMOUNT = [[ spec.threshold.amount ]]
    REFUND = [[ spec.threshold.refund ]]
    BONUS = [[ spec.threshold.bonus ]]

    PAYMENT_RULE = '[[ spec.payment.rule ]]'
    QUIZ_MAX_ATTEMPTS = [[ spec.comprehension.max_attempts ]]
    # Comprehension questions; answers are computed by expbuilder from the reference payoff model.
    QUIZ = [
[% for q in quiz %]        dict(
            key='[[ q.key ]]',
            text=[[ q.text | pyrepr ]],
            answer=[[ q.answer ]],
            explanation=[[ q.explanation | pyrepr ]],
        ),
[% endfor %]    ]
    QUIZ_ANSWERS = {
[% for q in quiz %]        '[[ q.key ]]': [[ q.answer ]],
[% endfor %]    }


class Subsession(BaseSubsession):
    pass


class Group(BaseGroup):
    total_contribution = models.IntegerField()
    individual_share = models.FloatField()
    threshold_met = models.BooleanField()


class Player(BasePlayer):
    contribution = models.IntegerField(
        min=0,
        max=C.ENDOWMENT,
        label="How many points do you contribute to the group account?",
    )
    contribution_timed_out = models.BooleanField(initial=False)
    stage1_earnings = models.FloatField()
[% if spec.punishment.enabled %][% for j in members %]    punish_[[ j ]] = models.IntegerField(
        min=0, max=C.PUNISH_MAX, initial=0, label="Deduction points for Member [[ j ]]"
    )
[% endfor %]    punishment_given = models.IntegerField(initial=0)
    punishment_received = models.IntegerField(initial=0)
    punish_timed_out = models.BooleanField(initial=False)
[% endif %]    round_earnings = models.FloatField()
    is_paying_round = models.BooleanField(initial=False)

    # comprehension quiz (round 1 only)
[% for q in quiz %]    [[ q.key ]] = models.FloatField(label=[[ q.text | pyrepr ]])
[% endfor %]    quiz_failed_attempts = models.IntegerField(initial=0)
    quiz_gave_up = models.BooleanField(initial=False)


# ---------------------------------------------------------------- session setup
def creating_session(subsession: Subsession):
    if subsession.round_number == 1:
        subsession.group_randomly()
        if C.PAYMENT_RULE == 'random_round':
            subsession.session.vars['paying_round'] = random.randint(1, C.NUM_ROUNDS)
    elif C.MATCHING == 'stranger':
        subsession.group_randomly()
    else:
        subsession.group_like_round(1)


# ---------------------------------------------------------------- payoffs
def set_stage1(group: Group):
    players = group.get_players()
    total = sum(p.contribution for p in players)
    group.total_contribution = total
    group.threshold_met = (not C.THRESHOLD) or total >= C.THRESHOLD_AMOUNT
    share = C.MPCR * total if group.threshold_met else 0.0
    group.individual_share = round(share, 2)
    bonus = C.BONUS if (C.THRESHOLD and group.threshold_met) else 0
    for p in players:
        if C.THRESHOLD and not group.threshold_met and C.REFUND:
            kept = C.ENDOWMENT
        else:
            kept = C.ENDOWMENT - p.contribution
        p.stage1_earnings = round(kept + share + bonus + 0.0, 2)
[% if not spec.punishment.enabled %]    set_final(group)
[% endif %]

[% if spec.punishment.enabled %]def points_assigned(sender: Player, receiver: Player) -> int:
    if sender.id_in_group == receiver.id_in_group:
        return 0
    return getattr(sender, 'punish_%d' % receiver.id_in_group) or 0


[% endif %]def set_final(group: Group):
    players = group.get_players()
    for p in players:
[% if spec.punishment.enabled %]        given = sum(points_assigned(p, o) for o in players)
        received = sum(points_assigned(o, p) for o in players)
        p.punishment_given = given
        p.punishment_received = received
        value = p.stage1_earnings - C.PUNISH_COST * given - C.PUNISH_IMPACT * received
        if C.FLOOR_AT_ZERO:
            value = max(value, 0.0)
        p.round_earnings = round(value + 0.0, 2)
[% else %]        p.round_earnings = p.stage1_earnings
[% endif %]        if C.PAYMENT_RULE == 'all_rounds':
            p.is_paying_round = True
        else:
            p.is_paying_round = p.round_number == p.session.vars['paying_round']
        p.payoff = cu(p.round_earnings) if p.is_paying_round else cu(0)


def history(player: Player):
    rows = []
    for past in player.in_all_rounds():
        earnings = past.field_maybe_none('round_earnings')
        if earnings is None:
            continue
        rows.append(
            dict(
                round=past.round_number,
                contribution=past.contribution,
                total=past.group.total_contribution,
                earnings=earnings,
            )
        )
    return rows


# ---------------------------------------------------------------- pages
class Introduction(Page):
    @staticmethod
    def is_displayed(player: Player):
        return player.round_number == 1


class Comprehension(Page):
    form_model = 'player'
    form_fields = [[ quiz | map(attribute='key') | list | pyrepr ]]

    @staticmethod
    def is_displayed(player: Player):
        return player.round_number == 1

    @staticmethod
    def error_message(player: Player, values):
        errors = {
            key: 'Not correct. Please re-read the instructions and try again.'
            for key, answer in C.QUIZ_ANSWERS.items()
            if values[key] is None or abs(values[key] - answer) > 0.005
        }
        if errors:
            player.quiz_failed_attempts += 1
            if player.quiz_failed_attempts >= C.QUIZ_MAX_ATTEMPTS:
                # let the participant continue; the correct answers are explained on the next page
                player.quiz_gave_up = True
                return None
            return errors


class ComprehensionFeedback(Page):
    @staticmethod
    def is_displayed(player: Player):
        return player.round_number == 1 and player.quiz_gave_up

    @staticmethod
    def vars_for_template(player: Player):
        return dict(quiz=C.QUIZ)


class Contribute(Page):
    form_model = 'player'
    form_fields = ['contribution']
    timeout_seconds = C.TIMEOUT_SECONDS

    @staticmethod
    def vars_for_template(player: Player):
        return dict(history=history(player) if C.SHOW_HISTORY else [])

    @staticmethod
    def before_next_page(player: Player, timeout_happened):
        if timeout_happened:
            player.contribution = 0
            player.contribution_timed_out = True


class StageOneWaitPage(WaitPage):
    after_all_players_arrive = 'set_stage1'


[% if spec.punishment.enabled %]class Punish(Page):
    form_model = 'player'
    timeout_seconds = C.TIMEOUT_SECONDS

    @staticmethod
    def get_form_fields(player: Player):
        return ['punish_%d' % o.id_in_group for o in player.get_others_in_group()]

    @staticmethod
    def vars_for_template(player: Player):
        return dict(
            others=[dict(id=o.id_in_group, contribution=o.contribution) for o in player.get_others_in_group()],
            budget=int(player.stage1_earnings // C.PUNISH_COST),
        )

    @staticmethod
    def error_message(player: Player, values):
        cost = C.PUNISH_COST * sum(v or 0 for v in values.values())
        if cost > player.stage1_earnings + 1e-9:
            return 'Assigning these points would cost %s, which is more than your earnings of %s in this round.' % (
                cost,
                player.stage1_earnings,
            )

    @staticmethod
    def before_next_page(player: Player, timeout_happened):
        if timeout_happened:
            for o in player.get_others_in_group():
                setattr(player, 'punish_%d' % o.id_in_group, 0)
            player.punish_timed_out = True


class PunishWaitPage(WaitPage):
    after_all_players_arrive = 'set_final'


[% endif %]class Results(Page):
    @staticmethod
    def vars_for_template(player: Player):
        members = []
        for o in player.group.get_players():
            members.append(
                dict(
                    id=o.id_in_group,
                    you=o.id_in_group == player.id_in_group,
                    contribution=o.contribution,
                )
            )
        return dict(members=members, history=history(player) if C.SHOW_HISTORY else [])


class FinalResults(Page):
    @staticmethod
    def is_displayed(player: Player):
        return player.round_number == C.NUM_ROUNDS

    @staticmethod
    def vars_for_template(player: Player):
        participant = player.participant
        return dict(
            paying_round=player.session.vars.get('paying_round'),
            total_points=participant.payoff,
            total_money=participant.payoff_plus_participation_fee(),
        )


page_sequence = [
    Introduction,
    Comprehension,
    ComprehensionFeedback,
    Contribute,
    StageOneWaitPage,
[% if spec.punishment.enabled %]    Punish,
    PunishWaitPage,
[% endif %]    Results,
    FinalResults,
]


# ---------------------------------------------------------------- data export
def custom_export(players):
    """Tidy long format: one row per participant and round (Data > Custom export in the admin)."""
    header = [
        'session', 'participant', 'round', 'group', 'member', 'contribution', 'contribution_timed_out',
        'group_total', 'threshold_met', 'stage1_earnings',
[% if spec.punishment.enabled %][% for j in members %]        'points_to_[[ j ]]',
[% endfor %]        'punishment_given', 'punishment_received',
[% endif %]        'round_earnings', 'is_paying_round', 'quiz_failed_attempts', 'quiz_gave_up',
    ]
    yield header
    for p in players:
        g = p.group
        first = p.in_round(1)
        yield [
            p.session.code, p.participant.code, p.round_number, g.id_in_subsession, p.id_in_group,
            p.field_maybe_none('contribution'), p.contribution_timed_out,
            g.field_maybe_none('total_contribution'), g.field_maybe_none('threshold_met'),
            p.field_maybe_none('stage1_earnings'),
[% if spec.punishment.enabled %][% for j in members %]            p.field_maybe_none('punish_[[ j ]]'),
[% endfor %]            p.punishment_given, p.punishment_received,
[% endif %]            p.field_maybe_none('round_earnings'), p.is_paying_round,
            first.quiz_failed_attempts, first.quiz_gave_up,
        ]
