"""oTree bot tests for [[ spec.name ]] (generated by expbuilder).

Run with:  otree test [[ spec.name ]]

Cases
-----
random        random contributions and random (budget-feasible) deductions
free_rider    member 1 never contributes, everybody else contributes everything
quiz_struggle member 1 fails the quiz on every attempt and is shown the correct answers

After every round the bots recompute each payoff independently. If the
expbuilder package is importable, the reference payoff model is used, so the
generated app is checked against the same code that produced the quiz answers.
"""
import json
import random

from otree.api import Bot, Submission, SubmissionMustFail, expect

from . import *

SPEC_JSON = [[ spec_json | pyrepr ]]

try:  # reference implementation (available when expbuilder is installed)
    from expbuilder.games import public_goods as _ref
    from expbuilder.spec import parse_spec as _parse

    _SPEC = _parse(json.loads(SPEC_JSON))
except ImportError:  # pragma: no cover
    _ref = None


def _expected(group):
    players = sorted(group.get_players(), key=lambda p: p.id_in_group)
    contributions = [p.contribution for p in players]
[% if spec.punishment.enabled %]    n = len(players)
    matrix = [[ '[[' ]]0] * n for _ in range(n)]
    for i, p in enumerate(players):
        for j, o in enumerate(players):
            if i != j:
                matrix[i][j] = getattr(p, 'punish_%d' % o.id_in_group)
[% else %]    matrix = None
[% endif %]    if _ref is not None:
        return _ref.final_payoffs(_SPEC, contributions, matrix)
    # fallback: independent re-implementation
    total = sum(contributions)
    met = (not C.THRESHOLD) or total >= C.THRESHOLD_AMOUNT
    share = C.MPCR * total if met else 0
    bonus = C.BONUS if (C.THRESHOLD and met) else 0
    out = []
    for i, c in enumerate(contributions):
        kept = C.ENDOWMENT if (C.THRESHOLD and not met and C.REFUND) else C.ENDOWMENT - c
        v = round(kept + share + bonus + 0.0, 2)
        if matrix is not None:
            given = sum(matrix[i])
            received = sum(row[i] for row in matrix)
            v = v - C.PUNISH_COST * given - C.PUNISH_IMPACT * received
            if C.FLOOR_AT_ZERO:
                v = max(v, 0.0)
            v = round(v + 0.0, 2)
        out.append(v)
    return out


class PlayerBot(Bot):
    cases = ['random', 'free_rider', 'quiz_struggle']

    def play_round(self):
        rng = random.Random(1000 * self.round_number + self.player.id_in_group)
        if self.round_number == 1:
            yield Introduction
            answers = dict(C.QUIZ_ANSWERS)
            if self.case == 'quiz_struggle' and self.player.id_in_group == 1:
                wrong = {k: v + 1 for k, v in answers.items()}
                for _ in range(C.QUIZ_MAX_ATTEMPTS - 1):
                    yield SubmissionMustFail(Comprehension, wrong)
                yield Comprehension, wrong
                expect(self.player.quiz_gave_up, True)
                yield ComprehensionFeedback
            else:
                yield Comprehension, answers
                expect(self.player.quiz_gave_up, False)

        if self.case == 'free_rider':
            c = 0 if self.player.id_in_group == 1 else C.ENDOWMENT
        else:
            c = rng.randint(0, C.ENDOWMENT)
        yield SubmissionMustFail(Contribute, dict(contribution=C.ENDOWMENT + 1))
        yield Contribute, dict(contribution=c)
[% if spec.punishment.enabled %]
        budget = int(self.player.stage1_earnings // C.PUNISH_COST)
        others = [o.id_in_group for o in self.player.get_others_in_group()]
        points = {}
        for j in others:
            k = min(C.PUNISH_MAX, budget, rng.randint(0, C.PUNISH_MAX)) if self.case != 'free_rider' else 0
            if self.case == 'free_rider' and self.player.id_in_group != 1 and j == 1:
                k = min(C.PUNISH_MAX, budget)   # cooperators punish the free rider
            budget -= k
            points['punish_%d' % j] = k
        too_much = {key: C.PUNISH_MAX for key in points}
        if C.PUNISH_COST * C.PUNISH_MAX * len(others) > self.player.stage1_earnings:
            yield SubmissionMustFail(Punish, too_much)
        yield Punish, points
[% endif %]
        yield Results

        expected = _expected(self.group)
        expect(abs(self.player.round_earnings - expected[self.player.id_in_group - 1]) < 1e-6, True)
        if self.case == 'free_rider' and not C.PUNISHMENT and not C.THRESHOLD and self.player.id_in_group == 1:
            # the free rider earns strictly more than any cooperator in a social dilemma
            others_earnings = [o.round_earnings for o in self.player.get_others_in_group()]
            expect(self.player.round_earnings > max(others_earnings), True)

        if self.round_number == C.NUM_ROUNDS:
            paid = [p for p in self.player.in_all_rounds() if p.is_paying_round]
            expect(len(paid), C.NUM_ROUNDS if C.PAYMENT_RULE == 'all_rounds' else 1)
            # the final page has no Next button by design; render it without the HTML button check
            yield Submission(FinalResults, check_html=False)
